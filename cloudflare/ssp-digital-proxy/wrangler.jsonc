{
  "name": "ssp-digital-pages-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "diegobezerra.com.br/personal-projects/ssp-digital",
      "zone_name": "diegobezerra.com.br"
    },
    {
      "pattern": "diegobezerra.com.br/personal-projects/ssp-digital/*",
      "zone_name": "diegobezerra.com.br"
    }
  ]
}
